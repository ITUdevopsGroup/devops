    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "id": 101,
      "title": "🌐 How are users experiencing it?",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 10,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "title": "HTTP Request Rate by Endpoint",
      "description": "Shows how many requests per second each part of the application receives.\n\nWhat each endpoint does:\n\n/ — The front page or health check, used to verify the backend is running.\n\n/user — Fetches user info, e.g. during login.\n\n/register — Creates a new user account.\n\n/spec_user — Loads a specific user's profile page.\n\n/is_followed — Checks if one user follows another, used to display the follow/unfollow button correctly.\n\n/follow and /unfollow — Follow or unfollow a user.\n\n/add_message — Posts a new tweet/message.\n\n/stats — Returns application statistics.\n\n/latest — Called constantly by the course simulator (not real users). It tracks how far the simulator has progressed. This endpoint will likely have the most traffic.",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[1m]))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 11,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "title": "Response Time p99 by Endpoint",
      "description": "Shows the response time for the slowest 1% of requests on each endpoint. For example, if 100 users visit /timeline, this shows how long the slowest user had to wait. This is important because the average can look fine even when some users are having a terrible experience.\n\nWhat each endpoint does:\n\n/ — The front page or health check.\n\n/user — Fetches user info, e.g. during login.\n\n/register — Creates a new user account.\n\n/spec_user — Loads a specific user's profile page.\n\n/is_followed — Checks if one user follows another.\n\n/follow and /unfollow — Follow or unfollow a user.\n\n/add_message — Posts a new tweet/message.\n\n/stats — Returns application statistics.\n\n/latest — Called constantly by the course simulator (not real users).\n\n",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "histogram_quantile(0.99, sum by (le, uri) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[1m])))",
          "legendFormat": "p99 {{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "id": 12,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "title": "HTTP Errors by Status Code",
      "description": "Shows how many errors are happening per second, broken down by status code and endpoint. This helps you pinpoint exactly where problems are occurring.\n\nCommon status codes:\n\n400 Bad Request — The request was malformed, e.g. missing a required field.\n\n401 Unauthorized — The user is not logged in or their session has expired.\n\n403 Forbidden — The user is logged in but not allowed to do this action.\n\n404 Not Found — The page or resource doesn't exist, e.g. a user profile that was deleted.\n\n409 Conflict — A duplicate action, e.g. trying to register a username that already exists.\n\n500 Internal Server Error — Something crashed on the server, usually a bug in the code.\n\n503 Service Unavailable — The server is overloaded or temporarily down.\n\nIf you see a spike on a specific endpoint, check the status code to understand what kind of error users are hitting.",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "sum by (status, uri) (rate(http_server_requests_seconds_count{status=~\"4..|5..\"}[1m]))",
          "legendFormat": "{{status}} {{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "id": 13,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "title": "Response Time p50 vs p99",
      "description": "Compares two response time measurements across all endpoints combined.\n\np50 (median) — The response time that a typical user experiences. Half of all requests are faster than this, half are slower.\n\np99 — The response time for the slowest 1% of requests. This is what your worst-off users experience.\n\nA big gap between the two lines means some users are having a much worse experience than most. Ideally both lines stay low and close together.\n\n",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[1m])))",
          "legendFormat": "p50 (median)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[1m])))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ]
    },

