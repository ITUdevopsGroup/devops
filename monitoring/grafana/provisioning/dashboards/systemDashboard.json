      "title": "Disk Usage",
      "description": "Shows how much of the server's hard drive is filled up, displayed as a bar. If the disk gets full, the application can no longer save data, write logs, or store anything — which will cause crashes. Keep an eye on this if your database or log files are growing.",
      "type": "bargauge",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "100 - (node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"} * 100)",
